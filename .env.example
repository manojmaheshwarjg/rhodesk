# --- Rho ---
# live      = call the real API at RHO_BASE_URL below
# fixtures  = generated 18-month ledger, no network, richer than the sandbox
RHO_MODE=live

# --- Rho endpoints -------------------------------------------------------------------
# The sandbox needs no account and accepts any non-empty bearer token.
# Leave these as they are to build against fictional, deterministic data.
RHO_BASE_URL=https://rhoapi-sandbox.rho.co/api/v1
RHO_TOKEN=sandbox
# For production, create a token in Rho settings (Owner/Admin, 2FA gated):
# RHO_BASE_URL=https://rhoapi.rho.co/api/v1
# RHO_TOKEN=rhobat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Tavily ----------------------------------------------------------------
# Without this, search and extract return deterministic stubs.
TAVILY_API_KEY=

# --- LLM -------------------------------------------------------------------
# anthropic | openai | off. Without a key, entity resolution and the call
# brief fall back to rules, and the pipeline still completes.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Groq is OpenAI-compatible and fast. A desk run makes one call per
# counterparty, so latency compounds; this is the cheapest way to make a full
# run feel instant.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- ElevenLabs ------------------------------------------------------------
# Without these, calls run as a scripted simulation, which is what you want
# until telephony is set up.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# The id ElevenLabs gives the number after you import it under Phone Numbers.
# Same field whichever carrier it came from.
ELEVENLABS_PHONE_NUMBER_ID=
# Which carrier to dial through: twilio | exotel | sip_trunk. All three take
# the same request and return the same response, so this only picks a URL.
# Use exotel for Indian numbers. It needs the Voicebot applet enabled on your
# Exotel account, which Exotel support turns on in 1 to 2 business days.
ELEVENLABS_TELEPHONY=twilio

# --- Desk ------------------------------------------------------------------
COMPANY_NAME=FusionTech
# Calls above this (in cents) need a human to approve. 2500000 = $25,000.
APPROVAL_THRESHOLD_CENTS=2500000
OVERDUE_DAYS=1
# ALWAYS set this before a live demo so the agent dials you, not a stranger.
DEMO_OVERRIDE_NUMBER=

# --- History ---------------------------------------------------------------
# Read the fixtures ledger as it stood this many days ago. Only meaningful
# with RHO_MODE=fixtures, and only useful for seeding the "What changed"
# screen: a diff needs two runs that genuinely differ, and waiting a day for
# one is not a demo. `python seed_history.py 7` does both runs for you.
FIXTURE_DAYS_AGO=0
